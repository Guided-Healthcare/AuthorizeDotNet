<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">

    <!-- Authorize.Net Accept Hosted - PAYMENT page (getHostedPaymentPage). See:
         https://developer.authorize.net/api/reference/features/accept-hosted.html

         Design (hosted payment page, SAQ A): the browser POSTs a server-minted form token to
         https://(test|accept).authorize.net/payment/payment and the card form renders in a lightbox
         iframe. PAN/CVV never reach this application. Passing the party's customerProfileId makes the
         hosted form ALSO show the patient's saved cards AND (with addPaymentProfile) save a new card
         to their CIM profile. The form runs auth-and-capture (authCaptureTransaction) in one step.

         On completion, Authorize.Net sends an 'action=transactResponse' message through the merchant
         IFrameCommunicator page (requires showReceipt=false). We then confirm the transaction
         authoritatively from the gateway (getTransactionDetails) and record the authorized Payment
         against the order; we never trust the client-relayed response for the money decision.

         Unlike the hosted PROFILE page, the PAYMENT page reliably emits transactResponse — this is
         the documented iframe success callback. -->

    <!-- Ensure the party has an Authorize.Net CIM customer profile, so the hosted payment form can
         show their saved cards and save new ones. Returns customerProfileId (party.gatewayCimId). -->
    <service verb="ensure" noun="CustomerProfile">
        <in-parameters>
            <parameter name="partyId" required="true"/>
            <parameter name="paymentGatewayConfigId" required="true"/>
        </in-parameters>
        <out-parameters><parameter name="customerProfileId"/></out-parameters>
        <actions>
            <entity-find-one entity-name="mantle.party.Party" value-field="party" for-update="true">
                <field-map field-name="partyId"/>
            </entity-find-one>
            <if condition="party == null"><return error="true" message="Party ${partyId} not found."/></if>
            <if condition="party.gatewayCimId">
                <set field="customerProfileId" from="party.gatewayCimId"/>
                <return/>
            </if>

            <entity-find-one entity-name="AuthorizeDotNet.PaymentGatewayAuthorizeNet" value-field="pgan"/>
            <if condition="pgan == null"><return error="true" message="Gateway ${paymentGatewayConfigId} not found."/></if>

            <!-- Email is optional. Resolve via the party's primary email contact mech (the
                 'Email#...ContactMech' relationship exists on PaymentMethod, NOT Party). -->
            <service-call name="mantle.party.ContactServices.get#PartyContactInfo" out-map="partyContact"
                    in-map="[partyId:partyId, emailContactMechPurposeId:'EmailPrimary']"/>
            <set field="emailAddress" from="partyContact?.emailAddress ?: ''"/>
            <script><![CDATA[requestString = """<?xml version="1.0" encoding="utf-8"?>
<createCustomerProfileRequest xmlns="AnetApi/xml/v1/schema/AnetApiSchema.xsd">
    <merchantAuthentication><name>${pgan.login}</name><transactionKey>${pgan.tranKey}</transactionKey></merchantAuthentication>
    <profile>
        <merchantCustomerId>${party.partyId}_${getRandomString(5)}</merchantCustomerId>
        <email>${emailAddress}</email>
    </profile>
</createCustomerProfileRequest>
            """]]></script>
            <!-- NOTE: never log requestString; it contains merchant credentials. -->
            <set field="responseString" from="org.moqui.util.WebUtilities.simpleHttpStringRequest(pgan.transactionUrl, requestString, 'text/xml')"/>
            <set field="responseNode" from="new groovy.xml.XmlParser().parseText(responseString)"/>
            <set field="responseCode" from="responseNode.messages[0]?.resultCode[0]?.text()"/>

            <if condition="!'Ok'.equalsIgnoreCase(responseCode ?: '')">
                <!-- Duplicate-profile error (E00039) carries the existing profile id in the text. -->
                <set field="dupId" from="responseNode.messages[0]?.message[0]?.text[0]?.text()?.replaceAll(/\D/, '')"/>
                <if condition="dupId"><then>
                    <set field="customerProfileId" from="dupId"/>
                </then><else>
                    <log level="warn" message="createCustomerProfile failed for party ${partyId}: ${responseString}"/>
                    <return error="true" type="danger" message="Could not initialize payment profile."/>
                </else></if>
            </if>
            <if condition="!customerProfileId">
                <set field="customerProfileId" from="responseNode.customerProfileId[0]?.text()"/>
            </if>
            <if condition="!customerProfileId"><return error="true" type="danger"
                    message="Could not initialize payment profile (no id)."/></if>

            <set field="party.gatewayCimId" from="customerProfileId"/>
            <entity-update value-field="party"/>
        </actions>
    </service>

    <!-- Mint a one-time Accept Hosted PAYMENT page token for an order. authCaptureTransaction (one
         step). customerProfileId makes saved cards appear + new cards save (addPaymentProfile).
         showReceipt=false is REQUIRED so the iframe receives action=transactResponse. -->
    <service verb="mint" noun="HostedPaymentToken">
        <in-parameters>
            <parameter name="orderId" required="true"/>
            <parameter name="orderPartSeqId" default-value="01"/>
            <parameter name="partyId"><description>Customer party; defaults from the order part.</description></parameter>
            <parameter name="paymentGatewayConfigId"/>
            <parameter name="iframeCommunicatorUrl" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="formToken"/>
            <parameter name="amount"/>
        </out-parameters>
        <actions>
            <entity-find-one entity-name="mantle.order.OrderHeader" value-field="orderHeader">
                <field-map field-name="orderId"/>
            </entity-find-one>
            <if condition="orderHeader == null"><return error="true" type="danger" public="true"
                    message="Order not found, cannot start payment."/></if>
            <entity-find-one entity-name="mantle.order.OrderPart" value-field="orderPart">
                <field-map field-name="orderId"/><field-map field-name="orderPartSeqId"/>
            </entity-find-one>
            <if condition="!partyId"><set field="partyId" from="orderPart?.customerPartyId"/></if>

            <set field="amount" from="orderHeader.grandTotal"/>
            <if condition="amount == null || amount &lt;= 0"><return error="true" type="danger" public="true"
                    message="Order total is not payable."/></if>

            <service-call name="AuthorizeDotNet.CimServices.get#PaymentGatewayConfig"
                    in-map="[paymentGatewayConfigId:paymentGatewayConfigId]" out-map="gwOut"/>
            <set field="paymentGatewayConfigId" from="gwOut.paymentGatewayConfigId ?: paymentGatewayConfigId"/>
            <if condition="!paymentGatewayConfigId">
                <set field="paymentGatewayConfigId" from="ec.user.getPreference('AuthorizeNetCimPaymentGatewayConfigId')"/>
            </if>
            <if condition="!paymentGatewayConfigId"><return error="true" type="danger"
                    message="No Authorize.Net payment gateway configured."/></if>
            <entity-find-one entity-name="AuthorizeDotNet.PaymentGatewayAuthorizeNet" value-field="pgan"/>
            <if condition="pgan == null"><return error="true" type="danger"
                    message="PaymentGatewayAuthorizeNet ${paymentGatewayConfigId} not found."/></if>

            <!-- Resolve (or create) the party's CIM customer profile so saved cards show + new save. -->
            <if condition="partyId">
                <service-call name="AuthorizeDotNet.HostedServices.ensure#CustomerProfile"
                        in-map="[partyId:partyId, paymentGatewayConfigId:paymentGatewayConfigId]" out-map="ensureOut"/>
                <if condition="ec.message.hasError()"><return/></if>
                <set field="customerProfileId" from="ensureOut.customerProfileId"/>
            </if>
            <set field="customerProfileXml" from="customerProfileId
                    ? ('&lt;profile&gt;&lt;customerProfileId&gt;' + customerProfileId + '&lt;/customerProfileId&gt;&lt;/profile&gt;')
                    : ''"/>

            <!-- hostedPaymentSettings values are JSON strings. showReceipt=false is required for the
                 iframe transactResponse callback. addPaymentProfile saves a new card to the CIM profile. -->
            <set field="refId" from="orderId"/>
            <if condition="refId.length() > 20"><set field="refId" from="refId.substring(0, 20)"/></if>
            <script><![CDATA[requestString = """<?xml version="1.0" encoding="utf-8"?>
<getHostedPaymentPageRequest xmlns="AnetApi/xml/v1/schema/AnetApiSchema.xsd">
    <merchantAuthentication><name>${pgan.login}</name><transactionKey>${pgan.tranKey}</transactionKey></merchantAuthentication>
    <refId>${refId}</refId>
    <transactionRequest>
        <transactionType>authCaptureTransaction</transactionType>
        <amount>${amount}</amount>
        ${customerProfileXml}
        <order><invoiceNumber>${orderId}</invoiceNumber><description>UniquelyMe order ${orderId}</description></order>
    </transactionRequest>
    <hostedPaymentSettings>
        <setting><settingName>hostedPaymentReturnOptions</settingName><settingValue>{"showReceipt": false}</settingValue></setting>
        <setting><settingName>hostedPaymentButtonOptions</settingName><settingValue>{"text": "Pay"}</settingValue></setting>
        <setting><settingName>hostedPaymentStyleOptions</settingName><settingValue>{"bgColor": "#1f2933"}</settingValue></setting>
        <setting><settingName>hostedPaymentPaymentOptions</settingName><settingValue>{"showCreditCard": true, "showBankAccount": false}</settingValue></setting>
        <setting><settingName>hostedPaymentBillingAddressOptions</settingName><settingValue>{"show": true, "required": false}</settingValue></setting>
        <setting><settingName>hostedPaymentCustomerOptions</settingName><settingValue>{"showEmail": false, "addPaymentProfile": true}</settingValue></setting>
        <setting><settingName>hostedPaymentOrderOptions</settingName><settingValue>{"show": false}</settingValue></setting>
        <setting><settingName>hostedPaymentIFrameCommunicatorUrl</settingName><settingValue>{"url": "${iframeCommunicatorUrl}"}</settingValue></setting>
    </hostedPaymentSettings>
</getHostedPaymentPageRequest>
            """]]></script>
            <!-- NOTE: never log requestString; it contains merchant credentials. -->
            <set field="responseString" from="org.moqui.util.WebUtilities.simpleHttpStringRequest(pgan.transactionUrl, requestString, 'text/xml')"/>
            <set field="responseNode" from="new groovy.xml.XmlParser().parseText(responseString)"/>
            <set field="responseCode" from="responseNode.messages[0]?.resultCode[0]?.text()"/>
            <if condition="!'Ok'.equalsIgnoreCase(responseCode ?: '')">
                <set field="reasonMessage" from="responseNode.messages[0]?.message[0]?.text[0]?.text()"/>
                <log level="warn" message="getHostedPaymentPage failed for order ${orderId}: ${reasonMessage}"/>
                <return error="true" type="danger" public="true"
                        message="Could not start payment: ${reasonMessage ?: 'gateway error'}"/>
            </if>
            <set field="formToken" from="responseNode.token[0]?.text()"/>
            <if condition="!formToken"><return error="true" type="danger" public="true"
                    message="Payment could not be started (no form token)."/></if>
        </actions>
    </service>

    <!-- Confirm an Accept Hosted transaction authoritatively from the gateway and record the
         authorized Payment against the order. Called after the browser relays action=transactResponse.
         We re-fetch details from Authorize.Net (getTransactionDetails) rather than trusting the
         client-supplied response for the money decision. Also binds any newly created CIM profile. -->
    <service verb="confirm" noun="HostedTransaction">
        <in-parameters>
            <parameter name="orderId" required="true"/>
            <parameter name="orderPartSeqId" default-value="01"/>
            <parameter name="transId"><description>Optional. The hosted iframe transactResponse
                callback is unreliable in nested iframes, so when omitted we look up the transaction
                by our orderId (invoiceNumber) in the unsettled transaction list.</description></parameter>
            <parameter name="paymentGatewayConfigId"/>
        </in-parameters>
        <out-parameters>
            <parameter name="paymentId"/>
            <parameter name="paymentStatusId"/>
            <parameter name="authorized" type="Boolean"/>
        </out-parameters>
        <actions>
            <set field="authorized" from="false"/>
            <entity-find-one entity-name="mantle.order.OrderHeader" value-field="orderHeader">
                <field-map field-name="orderId"/>
            </entity-find-one>
            <if condition="orderHeader == null"><return error="true" message="Order ${orderId} not found."/></if>

            <service-call name="AuthorizeDotNet.CimServices.get#PaymentGatewayConfig"
                    in-map="[paymentGatewayConfigId:paymentGatewayConfigId]" out-map="gwOut"/>
            <set field="paymentGatewayConfigId" from="gwOut.paymentGatewayConfigId ?: paymentGatewayConfigId"/>
            <if condition="!paymentGatewayConfigId">
                <set field="paymentGatewayConfigId" from="ec.user.getPreference('AuthorizeNetCimPaymentGatewayConfigId')"/>
            </if>
            <entity-find-one entity-name="AuthorizeDotNet.PaymentGatewayAuthorizeNet" value-field="pgan"/>
            <if condition="pgan == null"><return error="true" message="Gateway ${paymentGatewayConfigId} not found."/></if>

            <!-- Reliable path: no transId from the unreliable iframe callback. Find our transaction
                 by invoiceNumber (== orderId) in the unsettled transaction list. A fresh
                 auth-capture is unsettled until the nightly batch, so it will be present here. -->
            <if condition="!transId">
                <script><![CDATA[listRequest = """<?xml version="1.0" encoding="utf-8"?>
<getUnsettledTransactionListRequest xmlns="AnetApi/xml/v1/schema/AnetApiSchema.xsd">
    <merchantAuthentication><name>${pgan.login}</name><transactionKey>${pgan.tranKey}</transactionKey></merchantAuthentication>
    <sorting><orderBy>submitTimeUTC</orderBy><orderDescending>true</orderDescending></sorting>
    <paging><limit>100</limit><offset>1</offset></paging>
</getUnsettledTransactionListRequest>
                """]]></script>
                <set field="listResp" from="org.moqui.util.WebUtilities.simpleHttpStringRequest(pgan.transactionUrl, listRequest, 'text/xml')"/>
                <set field="listNode" from="new groovy.xml.XmlParser().parseText(listResp)"/>
                <if condition="'Ok'.equalsIgnoreCase(listNode.messages[0]?.resultCode[0]?.text() ?: '')">
                    <iterate list="listNode.transactions[0]?.transaction ?: []" entry="t">
                        <if condition="!transId &amp;&amp; (t.invoiceNumber[0]?.text() == orderId)">
                            <set field="transId" from="t.transId[0]?.text()"/>
                        </if>
                    </iterate>
                </if>
                <if condition="!transId">
                    <log level="info" message="confirm#HostedTransaction: no unsettled transaction yet for order ${orderId}"/>
                    <return/><!-- not charged yet; caller polls again -->
                </if>
            </if>

            <script><![CDATA[requestString = """<?xml version="1.0" encoding="utf-8"?>
<getTransactionDetailsRequest xmlns="AnetApi/xml/v1/schema/AnetApiSchema.xsd">
    <merchantAuthentication><name>${pgan.login}</name><transactionKey>${pgan.tranKey}</transactionKey></merchantAuthentication>
    <transId>${transId}</transId>
</getTransactionDetailsRequest>
            """]]></script>
            <set field="responseString" from="org.moqui.util.WebUtilities.simpleHttpStringRequest(pgan.transactionUrl, requestString, 'text/xml')"/>
            <set field="responseNode" from="new groovy.xml.XmlParser().parseText(responseString)"/>
            <set field="responseCode" from="responseNode.messages[0]?.resultCode[0]?.text()"/>
            <if condition="!'Ok'.equalsIgnoreCase(responseCode ?: '')">
                <log level="warn" message="getTransactionDetails failed for order ${orderId} trans ${transId}"/>
                <return/>
            </if>

            <set field="txn" from="responseNode.transaction[0]"/>
            <set field="txnStatus" from="txn?.transactionStatus[0]?.text()"/>
            <set field="responseReason" from="txn?.responseCode[0]?.text()"/>
            <!-- responseCode 1 = approved; these statuses mean authorized/captured. -->
            <set field="authorized" from="(responseReason == '1') &amp;&amp;
                    (txnStatus in ['authorizedPendingCapture','capturedPendingSettlement','settledSuccessfully'])"/>
            <if condition="!authorized"><return/></if>

            <!-- Bind any newly created CIM customer/payment profile ids to the party. -->
            <set field="profile" from="txn?.profile[0]"/>
            <set field="returnedCustomerProfileId" from="profile?.customerProfileId[0]?.text()"/>
            <entity-find-one entity-name="mantle.order.OrderPart" value-field="orderPart">
                <field-map field-name="orderId"/><field-map field-name="orderPartSeqId"/>
            </entity-find-one>
            <set field="customerPartyId" from="orderPart?.customerPartyId"/>
            <if condition="customerPartyId &amp;&amp; returnedCustomerProfileId">
                <entity-find-one entity-name="mantle.party.Party" value-field="party" for-update="true">
                    <field-map field-name="partyId" from="customerPartyId"/>
                </entity-find-one>
                <if condition="party != null &amp;&amp; !party.gatewayCimId">
                    <set field="party.gatewayCimId" from="returnedCustomerProfileId"/>
                    <entity-update value-field="party"/>
                </if>
            </if>

            <!-- Record/approve the Mantle Payment for the order so downstream status is authoritative. -->
            <entity-find entity-name="mantle.account.payment.Payment" list="payments">
                <econdition field-name="orderId"/>
                <econdition field-name="orderPartSeqId"/>
                <order-by field-name="paymentId"/>
            </entity-find>
            <if condition="payments"><then>
                <set field="pmt" from="payments[0]"/>
            </then><else>
                <service-call name="create#mantle.account.payment.Payment" out-map="createPmtOut"
                        in-map="[orderId:orderId, orderPartSeqId:orderPartSeqId,
                                 paymentTypeEnumId:'PtInvoicePayment', statusId:'PmntProposed',
                                 amount:orderHeader.grandTotal, amountUomId:orderHeader.currencyUomId,
                                 fromPartyId:customerPartyId,
                                 paymentGatewayConfigId:paymentGatewayConfigId]"/>
                <entity-find-one entity-name="mantle.account.payment.Payment" value-field="pmt">
                    <field-map field-name="paymentId" from="createPmtOut.paymentId"/>
                </entity-find-one>
            </else></if>
            <if condition="pmt != null">
                <service-call name="update#mantle.account.payment.Payment"
                        in-map="[paymentId:pmt.paymentId, statusId:'PmntDelivered',
                                 paymentRefNum:transId, paymentGatewayConfigId:paymentGatewayConfigId]"/>
                <service-call name="create#mantle.account.method.PaymentGatewayResponse"
                        in-map="[paymentGatewayConfigId:paymentGatewayConfigId, paymentOperationEnumId:'PgoAuthAndCapture',
                                 paymentId:pmt.paymentId, amountUomId:orderHeader.currencyUomId,
                                 amount:orderHeader.grandTotal, referenceNum:transId,
                                 transactionDate:ec.user.nowTimestamp, resultSuccess:'Y', resultError:'N',
                                 responseCode:responseReason]"/>
                <set field="paymentId" from="pmt.paymentId"/>
                <set field="paymentStatusId" value="PmntDelivered"/>
            </if>
        </actions>
    </service>

</services>
